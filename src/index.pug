    script.
      // Detectare locație utilizator și schimbare limbă
      $(document).ready(function() {
        $.get("https://ipinfo.io?token=aa50182e68a470", function(response) {
          var country = response.country;
          console.log("Țara utilizatorului: " + country);

          // Schimbă limba în funcție de țară
          if (country === "RO") {
            changeLanguageTo("ro");
          } else if (country === "FR") {
            changeLanguageTo("fr");
          } else {
            changeLanguageTo("en");
          }
        }, "jsonp");

        function changeLanguageTo(language) {
          if (language === "ro") {
            $("body").html($("body").html().replace("Lorem Ipsum is simply dummy text", "Lorem Ipsum este un simplu text de umplutură"));
            $("body").html($("body").html().replace("About Me", "Despre Mine"));
            $("body").html($("body").html().replace("Download my CV", "Descarcă CV-ul meu"));
            $("body").html($("body").html().replace("Let's Connect", "Să ne conectăm"));
            $("body").html($("body").html().replace("Skills", "Competențe"));
          } else if (language === "fr") {
            $("body").html($("body").html().replace("Lorem Ipsum is simply dummy text", "Lorem Ipsum est simplement un texte factice"));
            $("body").html($("body").html().replace("About Me", "À propos de moi"));
            $("body").html($("body").html().replace("Download my CV", "Téléchargez mon CV"));
            $("body").html($("body").html().replace("Let's Connect", "Connectons-nous"));
            $("body").html($("body").html().replace("Skills", "Compétences"));
          } else {
            // Implicit limba engleză
          }
        }
      });

